# VERITAS - Multi-Agent Technical Verification System
# Free tier configuration — $0 total cost

# ──────────────────────────────────────────
# REQUIRED: Groq API (free LLM inference)
# ──────────────────────────────────────────
# Get API key: https://console.groq.com/keys
# Model: mixtral-8x7b-32768 (free tier: 30 RPM)
GROQ_API_KEY=your_groq_api_key_here

# ──────────────────────────────────────────
# OPTIONAL: you.com Web Search API
# ──────────────────────────────────────────
# API docs: https://you.com/developers
# Set ENABLE_YOUCOM=true to activate
YOU_COM_API_KEY=your_youcom_api_key_here
ENABLE_YOUCOM=false

# ──────────────────────────────────────────
# Environment
# ──────────────────────────────────────────
NODE_ENV=development
